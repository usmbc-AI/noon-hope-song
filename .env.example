# 환경변수 템플릿 (이 파일은 커밋해도 됨 — 실제 값은 넣지 말 것)
# 실제 값은 .env.local 에 넣거나 Vercel 대시보드에 설정하세요.

GEMINI_API_KEY=여기에_Gemini_키
LASTFM_API_KEY=여기에_Lastfm_키
# GEMINI_MODEL=gemini-2.5-flash

# AI DJ 음성 — ElevenLabs(직접 만든 목소리). 둘 다 있으면 ElevenLabs로 읽음
ELEVENLABS_API_KEY=여기에_ElevenLabs_키
ELEVENLABS_VOICE_ID=여기에_목소리_ID
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SPEED=1.0        # 말 속도 0.7~1.2
# ELEVENLABS_STABILITY=0.5    # 0~1, 높을수록 일정한 톤
# ELEVENLABS_SIMILARITY=0.75  # 0~1

# AI DJ 음성 — OpenAI(ElevenLabs가 없거나 실패할 때 대신 읽음)
OPENAI_API_KEY=여기에_OpenAI_키
